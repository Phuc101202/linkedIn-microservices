# ─── Text files: normalize to LF in repo, checkout as-is on each OS ───
*           text=auto

# ─── Source code: always LF ───────────────────────────────────────────
*.java      text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.properties text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.sql       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf

# ─── Maven wrapper: mvnw phải là LF (Linux shell), mvnw.cmd phải CRLF ─
mvnw        text eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# ─── Docker & CI ──────────────────────────────────────────────────────
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# ─── Binary files: không chuyển đổi line ending ───────────────────────
*.jar       binary
*.class     binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
*.tar.gz    binary
*.war       binary
